# ---- Core --------------------------------------------------------------------------------------
APP_ENV=dev                         # dev | staging | prod
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
TENANT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- Database / cache --------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://de:de@db:5432/de      # Neon: postgresql+asyncpg://…neon.tech/…?ssl=require
REDIS_URL=redis://redis:6379/0                          # optional; empty = budgets counted in Postgres
WORKER_ACTIVE_HOURS=0-24                                # Profile B on Neon free: 7-23
WORKER_IDLE_POLL_SECONDS=30
WORKER_BATCH_SIZE=32

# ---- Security ----------------------------------------------------------------------------------
API_KEY_PEPPER=change-me-long-random
TOKEN_ENC_KEY=                      # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ALLOWED_EMAILS=you@gmail.com            # comma-separated Google accounts allowed to sign in
AUTH_SECRET=                        # Auth.js (web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RATE_LIMIT_PER_MIN=120
RAW_RETENTION_DAYS=180
AUDIO_RETENTION_DAYS=7

# ---- Laya --------------------------------------------------------------------------------------
LAYA_URL=http://laya:8000           # empty = off
LAYA_API_KEY=change-me-long-random  # same value is given to the laya service
LAYA_MODE=shadow                    # off | shadow | on (default for niches without an override)
LAYA_TIMEOUT_SECONDS=10
LAYA_MODEL=                         # empty = server auto-routing; later a fine-tuned checkpoint id

# ---- LLM providers (empty key = provider skipped) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-flash-lite-latest
GEMINI_RPD=500
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b
GROQ_RPD=1000
CEREBRAS_API_KEY=
CEREBRAS_MODEL=cerebras/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                   # pick a current :free model
OPENROUTER_RPD=50
SARVAM_API_KEY=
SARVAM_DAILY_INR=20
OLLAMA_URL=                         # http://host.docker.internal:11434 — required for private items on free tiers
OLLAMA_MODEL=ollama_chat/qwen3:8b
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PRIVATE_OK=false             # true only if your paid plan's data terms are acceptable for private items
LANGSMITH_API_KEY=                  # optional tracing

# ---- Connectors --------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_OAUTH_CLIENT_ID=             # Gmail (Testing mode)
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=                        # Instagram professional account
META_APP_SECRET=
META_VERIFY_TOKEN=
DATA_GOV_IN_API_KEY=                # Agmarknet (phase 7)
EXPO_ACCESS_TOKEN=                  # push (phase 6)
