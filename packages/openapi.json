            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "events": {
            "items": {
              "type": "string"
            },
            "title": "Events",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "events",
          "enabled",
          "created_at"
        ],
        "title": "SubscriptionOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Verdict": {
        "enum": [
          "approve",
          "reject",
          "edit",
          "snooze"
        ],
        "title": "Verdict",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Decision Engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "The process is up"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/deep": {
      "get": {
        "operationId": "health_deep",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeepHealth"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeepHealth"
                }
              }
            },
            "description": "Database is down"
          }
        },
        "summary": "Readiness with dependency checks",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/decide": {
      "post": {
        "operationId": "decide_sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecideIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecideOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Invalid questions, unknown or disabled niche"
          },
          "503": {
            "description": "No model could answer, or private with no private_ok provider"
          },
          "504": {
            "description": "Timed out after DECIDE_TIMEOUT_SECONDS"
          }
        },
        "summary": "Synchronous decision",
        "tags": [
          "decide"
        ]
      }
    },
    "/v1/feedback/export": {
      "get": {
        "operationId": "export_feedback",
        "parameters": [
          {
            "in": "query",
            "name": "niche",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Niche"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "laya_train",
              "enum": [
                "laya_train",
                "laya_eval"
              ],
              "title": "Format",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/x-ndjson": {
                "example": "{\"state\":\"Pay the water bill\",\"questions\":{\"needs_decision\":{\"options\":[\"yes\",\"no\"]}},\"gold\":{\"answers\":{\"needs_decision\":{\"yes\":0.9,\"no\":0.1}}}}\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "One JSON object per line (laya_train: gold, laya_eval: expected)"
          },
          "403": {
            "description": "API key lacks the admin scope"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export human decisions as JSONL",
        "tags": [
          "feedback"
        ]
      }
    },
    "/v1/items": {
      "get": {
        "description": "Newest first. `cursor` is the `next_cursor` of the previous page.",
        "operationId": "list_items",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "niche",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Niche"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List items",
        "tags": [
          "items"
        ]
      },
      "post": {
        "description": "Store the payload untouched and queue it for the pipeline. Idempotent.",
        "operationId": "create_item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestItemIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            },
            "description": "Repeat of (source, source_ref): the existing item"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit or daily item cap; see Retry-After"
          }
        },
        "summary": "Ingest one item",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/items/bulk": {
      "post": {
        "description": "One savepoint per row; a bad row never fails the others.",
        "operationId": "create_items_bulk",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Payload",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "207": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Daily item cap; see Retry-After"
          }
        },
        "summary": "Ingest up to 500 items",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/items/{item_id}": {
      "get": {
        "operationId": "get_item",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionItemOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such item for this tenant"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get one item",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/items/{item_id}/decision": {
      "post": {
        "operationId": "decide_item",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such item for this tenant"
          },
          "409": {
            "description": "Not awaiting approval, or another request holds the item"
          },
          "422": {
            "description": "Option is not one of the decision's options, or bad snooze time"
          }
        },
        "summary": "Approve, reject, edit or snooze a waiting decision",
        "tags": [
          "items"
        ]
      }
    },
    "/v1/niches/reload": {
      "post": {
        "operationId": "reload_niches",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReloadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "API key lacks the admin scope"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "example": {
                  "detail": "1 niche file(s) are invalid; previous versions stay active",
                  "errors": [
                    {
                      "file": "inbox.yaml",
                      "json_pointer": "/autonomy",
                      "message": "'yolo' is not one of ['ask', 'auto']"
                    }
                  ],
                  "status": 422,
                  "title": "Niche validation failed",
                  "type": "about:blank"
                }
              }
            },
            "description": "Validation errors; the previous niche set is still served"
          }
        },
        "summary": "Reload niche configs from disk",
        "tags": [
          "niches"
        ]
      }
    },
    "/v1/subscriptions": {
      "get": {
        "operationId": "list_subscriptions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionList"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "API key lacks the admin scope"
          }
        },
        "summary": "List webhook subscriptions",
        "tags": [
          "subscriptions"
        ]
      },
      "post": {
        "operationId": "create_subscription",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "API key lacks the admin scope"
          },
          "422": {
            "description": "Unsafe URL, unknown event, empty events or a short secret"
          }
        },
        "summary": "Create a webhook subscription",
        "tags": [
          "subscriptions"
        ]
      }
    },
    "/v1/subscriptions/{subscription_id}": {
      "delete": {
        "operationId": "delete_subscription",
        "parameters": [
          {
            "in": "path",
            "name": "subscription_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Subscription Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "API key lacks the admin scope"
          },
          "404": {
            "description": "No such subscription for this tenant"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a webhook subscription",
        "tags": [
          "subscriptions"
        ]
      }
    }
  }
}
