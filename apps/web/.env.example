# Web app (server-side secrets never reach the browser).
DE_API_URL=http://localhost:8000
# Scoped API key for the proxy (scopes: items:read, items:write). Server-only.
DE_API_KEY=de_replace_me
# Auth.js (Google). AUTH_SECRET: `openssl rand -base64 32`.
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed to sign in (everyone else is refused).
ALLOWED_EMAILS=
# Comma-separated subset of ALLOWED_EMAILS who may change settings (PUT /settings).
# The proxy key has admin scope, so empty means nobody can write settings.
ADMIN_EMAILS=
