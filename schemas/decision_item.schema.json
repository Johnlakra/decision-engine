{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-engine/schemas/decision_item.schema.json",
  "title": "DecisionItem",
  "description": "The one shape every item has after normalisation (GET /v1/items/{id}, webhook payloads).",
  "type": "object",
  "required": ["id", "source", "source_ref", "received_at", "status", "content"],
  "properties": {
    "id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "source": {"type": "string"},
    "source_ref": {"type": "string"},
    "received_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["new", "normalised", "triaged", "informational", "discarded", "deciding",
                        "awaiting_approval", "approved", "auto_approved", "rejected", "snoozed",
                        "acting", "done", "failed", "needs_human_triage"]},
    "language": {"type": "string"},
    "sensitivity": {"enum": ["public", "private"]},
    "content": {
      "type": "object", "required": ["title"],
      "properties": {
        "title": {"type": "string"},
        "body": {"type": "string"},
        "summary": {"type": "string"},
        "sender": {"type": "string"},
        "url": {"type": "string"},
        "attachments": {"type": "array", "items": {"type": "object",
          "properties": {"name": {"type": "string"}, "mime": {"type": "string"}, "text": {"type": "string"}, "ref": {"type": "string"}}}},
        "entities": {"type": "object", "description": "Niche extract output: dates, amounts, deadlines, crop, location…"},
        "language": {"type": ["string", "null"]},
        "flags": {"type": "array", "items": {"type": "string"}, "description": "e.g. normalise_failed"}
      }
    },
    "niche": {"type": ["string", "null"]},
    "urgency": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
    "risk": {"enum": ["normal", "spam", "scam_or_phishing", null]},
    "deadline_at": {"type": ["string", "null"], "format": "date-time"},
    "related_to": {"type": ["string", "null"]},
    "triage": {"type": ["object", "null"], "description": "See docs/DATA_MODEL.md items.triage"},
    "decision": {
      "type": ["object", "null"],
      "required": ["options", "recommended", "rationale", "confidence"],
      "properties": {
        "options": {"type": "array", "minItems": 2, "maxItems": 5, "items": {
          "type": "object", "required": ["id", "label"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"},
            "actions": {"type": "array", "items": {"type": "object", "required": ["type"],
              "properties": {"type": {"type": "string"}, "params": {"type": "object"}}}}}}},
        "recommended": {"type": "string"},
        "rationale": {"type": "string", "maxLength": 600},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "deadline": {"type": ["string", "null"], "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "autonomy": {"enum": ["suggest", "ask", "auto"]},
        "needs_expert": {"type": "boolean"},
        "model": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "niche_version": {"type": "integer"},
        "ready_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "last_decision": {"type": ["object", "null"], "properties": {
      "verdict": {"enum": ["approve", "reject", "edit", "snooze", "auto"]},
      "option": {"type": "string"}, "decided_by": {"enum": ["human", "auto", "llm"]},
      "decided_at": {"type": "string", "format": "date-time"}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
